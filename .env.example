# Valores públicos. Copiar a .env.local y completar allí.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase recomienda actualmente una clave publicable. El código acepta
# esta variable o, por compatibilidad, NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave privada moderna para las acciones administrativas del servidor.
# Crear una nueva en Supabase y completarla únicamente en .env.local.
SUPABASE_SECRET_KEY=

# Nunca usar SUPABASE_SECRET_KEY ni SUPABASE_SERVICE_ROLE_KEY en variables
# NEXT_PUBLIC_* o dentro de componentes del navegador.

# Ruta privada del servidor a Edge, Chrome o Chromium para generar los PDF.
# En Windows suele ser:
# C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
CHROMIUM_EXECUTABLE_PATH=
